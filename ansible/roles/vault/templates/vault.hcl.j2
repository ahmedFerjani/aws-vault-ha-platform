ui            = true
api_addr      = "{{ vault_api_addr }}"
cluster_addr  = "https://{{ ansible_facts['default_ipv4']['address'] }}:8201"
disable_mlock = true

storage "raft" {
  path = "/opt/vault/data"

  retry_join {
    auto_join             = "provider=aws region={{ raft_auto_join_region }} tag_key={{ raft_auto_join_tag_key }} tag_value={{ raft_auto_join_tag_value }} addr_type=private_v4"
    auto_join_scheme      = "https"
    auto_join_port        = 8200
    leader_tls_servername = "{{ raft_auto_join_tls_servername }}"
    leader_ca_cert_file   = "{{ raft_auto_join_ca_cert_file }}"
  }
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file   = "{{ tls_cert_file }}"
  tls_key_file    = "{{ tls_key_file }}"
  tls_min_version = "tls12"
}

seal "awskms" {
  region     = "{{ kms_region }}"
  kms_key_id = "{{ auto_unseal_kms_key_id }}"
}